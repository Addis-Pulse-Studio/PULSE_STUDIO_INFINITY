# `license-files` in pyproject.toml puts LICENSE and NOTICE into a wheel's
# .dist-info. This covers the sdist as well, and covers builders older than the
# setuptools that understands PEP 639 -- NOTICE carries upstream's MIT copyright
# notice, and MIT grants its permissions only while that notice travels with the
# copy, so it is worth stating twice.
include LICENSE
include NOTICE
include README.md
include CHANGELOG.md
include requirements.txt

recursive-include js *.js
recursive-include example_workflows *.json
# The placeholder references PulseSlate_Cast.json opens on. Without these the
# graph that demonstrates the asset bin ships with a bin pointing at nothing.
# Generated by tools/make_example_assets.py -- flat tones and a sine tone, so
# there is no provenance question attached to redistributing them.
recursive-include example_workflows/assets *.png *.wav
include tools/make_example_assets.py

# Pulse Studio Infinity: the example config, the director's desk tool, and the
# workspace kit tools/setup_director_workspace.py installs for an agent.
include pulse_infinity.example.yaml
include tools/pulse_desk.py
include tools/setup_director_workspace.py
recursive-include director_workspace *.md

# The GPL-3.0 reference tree is reviewed for feature ideas only; code from it
# would relicense this whole project. .gitignore keeps it out of git, which is
# not the same as keeping it out of a build. See NOTICE.
prune reference_purpose only
global-exclude __pycache__ *.py[cod]
